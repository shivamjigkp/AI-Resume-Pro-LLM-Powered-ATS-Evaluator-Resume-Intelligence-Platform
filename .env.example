# =====================================================================
# GOOGLE API SETTINGS
# =====================================================================
# Google Sheet ID where lead details are read from and updated.
GOOGLE_SHEET_ID=""

# =====================================================================
# PATH CONFIGURATIONS
# =====================================================================
# Path to your master base resume file (.docx format only).
BASE_RESUME_PATH="resume/base_resume.docx"

# Output folder for generated PDFs.
OUTPUT_RESUMES_DIR="output_resumes"

# =====================================================================
# RATE LIMITING & SAFETY CONTROLS (Gitleaks/ECC Compliance)
# =====================================================================
# Delay (in seconds) between sent emails to avoid Gmail anti-spam flags.
EMAIL_DELAY_SECONDS=45

# Standard timeout (in milliseconds) for Playwright script autofill.
AUTOFILL_WAIT_MS=2000

# =====================================================================
# GATE 2 — LEAD DISCOVERY (Apollo.io People Search API)
# =====================================================================
# Get a key: Apollo dashboard → Settings → Integrations → API.
# If this is empty, /api/gate2/discover-leads returns MOCK sample data.
APOLLO_API_KEY=""

# "true" enriches each match to reveal a VERIFIED work email.
# This consumes Apollo credits. Default "false" (search only; emails may be blank).
APOLLO_REVEAL_EMAILS="false"

# Max leads returned per search (1–100).
APOLLO_MAX_LEADS="10"
